// ClinicQ Firestore rules.
// Tested by rules-tests/ against the Firestore emulator (runs in GitHub Actions: job "rules").
//
// Model
//  - Patients sign in with Firebase phone auth → request.auth.token.phone_number == "+91XXXXXXXXXX".
//    Appointments store the 10-digit number, so '+91' + phone is compared.
//  - Staff sign in with email/password. The owner creates one document staff/{uid} = { clinicId } in the console
//    (nobody can write staff/ from the app). That is what makes someone staff of ONE clinic.
//  - Booking is one batch/transaction that writes three things together:
//      clinics/{c}/days/{doctorId_date}              { last, slots{time:count} }  public counters, no personal data
//      clinics/{c}/days/{doctorId_date}/people/{pid}  pid = phone_memberKey → blocks double booking of the same person
//      clinics/{c}/appts/{id}                         the appointment itself (private)
//    The appointment rule checks the counters AFTER the batch (getAfter), so a token can only be taken once
//    and a slot can't go over capacity.
//
// Known limit (documented, to harden later with a Cloud Function): a signed-in patient could tamper with the
// public counters (e.g. lower a slot count) — they still can never read anyone's appointment.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function hasPhone() { return signedIn() && 'phone_number' in request.auth.token; }
    function myPhone() { return request.auth.token.phone_number; }
    function isMine(phone) { return hasPhone() && phone is string && phone.size() == 10 && ('+91' + phone) == myPhone(); }
    function staffDoc() { return /databases/$(db)/documents/staff/$(request.auth.uid); }
    function isStaff(clinic) { return signedIn() && exists(staffDoc()) && get(staffDoc()).data.clinicId == clinic; }

    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Family members belong to one phone number only.
    match /patients/{phone}/members/{id} {
      allow read, write: if isMine(phone);
    }

    match /clinics/{clinic} {
      // Clinic name, doctors, timings and caps are public – patients need them to book.
      allow read: if true;
      allow write: if isStaff(clinic);

      match /days/{day} {
        allow read: if true;
        allow create, update: if isStaff(clinic) || (signedIn() && validDayWrite());
        allow delete: if false;

        function validDayWrite() {
          let n = request.resource.data;
          let before = resource == null ? { 'last': 0, 'slots': {} } : resource.data;
          return n.keys().hasOnly(['last', 'slots'])
            && n.last is int
            && (n.last == before.last || n.last == before.last + 1)
            && n.slots is map
            && n.slots.size() <= 80
            && n.slots.diff(before.slots).affectedKeys().size() <= 2;
        }

        // One entry per person per doctor per day (pid = phone + '_' + memberKey). Only the owner of that phone can touch it.
        match /people/{pid} {
          allow read, create, update, delete: if isStaff(clinic)
            || (hasPhone() && pid.matches(myPhone().replace('\\+91', '') + '_.*'));
        }
      }

      match /appts/{id} {
        function dayDoc() { return /databases/$(db)/documents/clinics/$(clinic)/days/$(request.resource.data.doctorId + '_' + request.resource.data.date); }
        function peopleDoc() { return /databases/$(db)/documents/clinics/$(clinic)/days/$(request.resource.data.doctorId + '_' + request.resource.data.date)/people/$(request.resource.data.phone + '_' + request.resource.data.memberId); }
        function cap() { return get(/databases/$(db)/documents/clinics/$(clinic)).data.caps.get(request.resource.data.doctorId, 1); }
        function tokenOk() { return request.resource.data.token is int && getAfter(dayDoc()).data.last == request.resource.data.token; }
        function base() {
          return request.resource.data.clinicId == clinic
            && request.resource.data.status == 'waiting'
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
            && tokenOk();
        }
        function patientBooking() {
          return isMine(request.resource.data.phone)
            && request.resource.data.memberId is string
            && request.resource.data.get('walkIn', false) == false
            && existsAfter(peopleDoc())
            && getAfter(dayDoc()).data.slots.get(request.resource.data.time, 0) <= cap();
        }

        // A patient sees only appointments made on their own number; staff see their own clinic's.
        allow read: if isStaff(clinic) || isMine(resource.data.phone);
        allow create: if base() && (isStaff(clinic) || patientBooking());
        // Patients may only flip their own appointment to cancelled; staff may change anything on their own clinic's appointments.
        allow update: if (isStaff(clinic) && request.resource.data.clinicId == clinic)
          || (isMine(resource.data.phone)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy'])
              && request.resource.data.status == 'cancelled'
              && request.resource.data.cancelledBy in ['patient', 'rescheduled']
              && resource.data.status == 'waiting');
        allow delete: if false;
      }
    }
  }
}
